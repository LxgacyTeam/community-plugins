<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WinterPack</AssemblyName>
    <Authors>dvwhrf</Authors>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)'==''">R:\BigCityLegacy\prod_game</GameDir>
    <ManagedDir>$(GameDir)\game_Data\Managed</ManagedDir>
    <BclDll Condition="'$(BclDll)'==''">$(GameDir)\BepInEx\plugins\BigCityLegacy\BigCityLegacy.dll</BclDll>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssetBundlePath Condition="'$(AssetBundlePath)'==''">$(MSBuildProjectDirectory)\assetbundle\winterpack.bundle</AssetBundlePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="$(AssetBundlePath)" LogicalName="WinterPack.Resources.winterpack.bundle" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BigCityLegacy"><HintPath>$(BclDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(ManagedDir)\UnityEngine.TerrainModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateEmbeddedBundle" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AssetBundlePath)')" Text="AssetBundle not found: $(AssetBundlePath). Run build.ps1 to build it with Unity first." />
  </Target>
</Project>
